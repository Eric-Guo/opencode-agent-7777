{
  "name": "@opencode/nexus-ui",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "exports": {
    "./browser-pane": "./src/runtime/platform/browser-pane.ts",
    "./desktop": "./server/desktop.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test:components": "playwright test --config playwright.components.config.ts",
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "build:shared": "bun scripts/build-shared.ts",
    "serve": "bun --bun vite preview",
    "models:apply-localstorage": "bun run scripts/apply-model-config-dump.ts",
    "test": "bun test --only-failures"
  },
  "dependencies": {
    "@cybros/agent": "file:../nexus-runtime/vendor/cybros-agent-0.1.0.tgz",
    "@opencode/client": "workspace:*",
    "@opencode/gui-plugins": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/session-ui": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@opencode/util": "workspace:*",
    "@solid-primitives/event-listener": "catalog:",
    "echarts": "6.1.0",
    "effect": "catalog:",
    "solid-js": "catalog:",
    "solid-presence": "0.2.0",
    "ws": "^8.18.0",
    "@opencode/protocol": "workspace:*",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "happy-dom": "20.11.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
